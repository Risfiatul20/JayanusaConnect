    {
      "name": "REGISTRATIONS",
      "item": [
        {
          "name": "List Registrasi Saya (Mahasiswa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/registrations", "host": ["{{base_url}}"], "path": ["api","registrations"] }
          }
        },
        {
          "name": "List SEMUA Registrasi (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/registrations?type=training&status=pending",
              "host": ["{{base_url}}"], "path": ["api","registrations"],
              "query": [
                { "key": "type", "value": "training" },
                { "key": "status", "value": "pending" }
              ]
            }
          }
        },
        {
          "name": "Daftar Mentoring Alumni - TRANSAKSI",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if(res.success){ pm.collectionVariables.set('registration_id', res.data.id); }",
                  "pm.test('Status 201', function(){ pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
