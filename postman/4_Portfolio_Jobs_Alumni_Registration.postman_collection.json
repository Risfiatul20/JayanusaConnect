                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": { "raw": "{{base_url}}/api/jobs", "host": ["{{base_url}}"], "path": ["api","jobs"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"title\": \"Frontend Developer\",\n  \"company\": \"PT. Digital Riau\",\n  \"type\": \"kerja\",\n  \"location\": \"Pekanbaru, Riau\",\n  \"description\": \"Mencari frontend developer berpengalaman React/Vue.\",\n  \"requirements\": \"- Min 1 tahun pengalaman\\n- Menguasai React atau Vue\",\n  \"salary_range\": \"Rp 5.000.000 - Rp 8.000.000\",\n  \"deadline\": \"2024-12-31\",\n  \"contact_email\": \"hr@digitalriau.co.id\"\n}"
            }
          }
        },
        {
          "name": "Tutup Lowongan (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": { "raw": "{{base_url}}/api/jobs/{{job_id}}", "host": ["{{base_url}}"], "path": ["api","jobs","{{job_id}}"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"status\": \"closed\"\n}"
            }
          }
        }
      ]
    },
