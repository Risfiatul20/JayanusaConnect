{
  "info": {
    "_postman_id": "a1b2c3d4-0004-0004-0004-000000000004",
    "name": "JAYANUSA Connect - 4. Portfolio, Jobs, Alumni, Registration",
    "description": "Endpoint Portfolio, Lowongan Kerja, Alumni, dan Registrasi Mentoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token_mahasiswa", "value": "ISI_TOKEN_MAHASISWA_DISINI", "type": "string" },
    { "key": "token_admin", "value": "ISI_TOKEN_ADMIN_DISINI", "type": "string" },
    { "key": "portfolio_id", "value": "1", "type": "string" },
    { "key": "job_id", "value": "1", "type": "string" },
    { "key": "alumni_id", "value": "1", "type": "string" },
    { "key": "registration_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "PORTFOLIOS",
      "item": [
        {
          "name": "List Portofolio (Semua)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios", "host": ["{{base_url}}"], "path": ["api","portfolios"] }
          }
        },
        {
          "name": "List Portofolio Filter Angkatan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/portfolios?angkatan=2021&category=Aplikasi",
              "host": ["{{base_url}}"], "path": ["api","portfolios"],
              "query": [
                { "key": "angkatan", "value": "2021" },
                { "key": "category", "value": "Aplikasi" }
              ]
            }
          }
        },
        {
          "name": "List Portofolio Milik Saya",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/portfolios?my=1",
              "host": ["{{base_url}}"], "path": ["api","portfolios"],
              "query": [{ "key": "my", "value": "1" }]
            }
          }
        },
        {
          "name": "Upload Portofolio Baru (tanpa file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if(res.success){ pm.collectionVariables.set('portfolio_id', res.data.id); }",
                  "pm.test('Status 201', function(){ pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios", "host": ["{{base_url}}"], "path": ["api","portfolios"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"title\": \"Aplikasi Absensi QR Code\",\n  \"category\": \"Aplikasi\",\n  \"description\": \"Aplikasi absensi menggunakan QR Code berbasis Flutter dan Laravel API.\",\n  \"github_url\": \"https://github.com/example/absensi-qr\",\n  \"demo_url\": \"https://absensi-demo.example.com\"\n}"
            }
          }
        },
        {
          "name": "Upload Portofolio + File (Form Data)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios", "host": ["{{base_url}}"], "path": ["api","portfolios"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Skripsi Sistem Rekomendasi", "type": "text" },
                { "key": "category", "value": "Skripsi", "type": "text" },
                { "key": "description", "value": "Skripsi tentang sistem rekomendasi berbasis collaborative filtering.", "type": "text" },
                { "key": "file", "src": [], "type": "file", "description": "Upload PDF/ZIP/DOC max 10MB" },
                { "key": "thumbnail", "src": [], "type": "file", "description": "Upload JPG/PNG max 2MB" }
              ]
            }
          }
        },
        {
          "name": "Detail Portofolio (increment views)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios/{{portfolio_id}}", "host": ["{{base_url}}"], "path": ["api","portfolios","{{portfolio_id}}"] }
          }
        },
        {
          "name": "Like Portofolio (Toggle)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios/{{portfolio_id}}/like", "host": ["{{base_url}}"], "path": ["api","portfolios","{{portfolio_id}}","like"] }
          }
        },
        {
          "name": "Hapus Portofolio (Pemilik)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }
            ],
            "url": { "raw": "{{base_url}}/api/portfolios/{{portfolio_id}}", "host": ["{{base_url}}"], "path": ["api","portfolios","{{portfolio_id}}"] }
          }
        }
      ]
    },
    {
