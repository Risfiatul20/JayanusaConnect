{
  "info": {
    "_postman_id": "a1b2c3d4-0002-0002-0002-000000000002",
    "name": "JAYANUSA Connect - 2. Aspirasi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token_mahasiswa", "value": "", "type": "string" },
    { "key": "token_admin", "value": "", "type": "string" },
    { "key": "aspiration_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "STEP 1 - Login Mahasiswa (Jalankan Dulu)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var res = pm.response.json();", "if(res.success){ pm.collectionVariables.set('token_mahasiswa', res.data.token); pm.test('Token mahasiswa tersimpan', function(){ pm.expect(res.data.token).to.be.a('string'); }); }"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"budi@mahasiswa.jayanusa.ac.id\",\n  \"password\": \"password123\"\n}" }
      },
      "response": []
    },
    {
      "name": "STEP 2 - Login Admin BEM (Jalankan Dulu)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var res = pm.response.json();", "if(res.success){ pm.collectionVariables.set('token_admin', res.data.token); pm.test('Token admin tersimpan', function(){ pm.expect(res.data.token).to.be.a('string'); }); }"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"admin.bem@jayanusa.ac.id\",\n  \"password\": \"password123\"\n}" }
      },
      "response": []
    },
    {
      "name": "Kirim Aspirasi Baru (Mahasiswa)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var res = pm.response.json();", "if(res.success){ pm.collectionVariables.set('aspiration_id', String(res.data.id)); }", "pm.test('Status 201', function(){ pm.response.to.have.status(201); });", "pm.test('Status = dikirim', function(){ pm.expect(res.data.status).to.eql('dikirim'); });"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations", "host": ["{{base_url}}"], "path": ["api","aspirations"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"title\": \"Permohonan Penambahan Fasilitas Parkir\",\n  \"content\": \"Fasilitas parkir di kampus sangat kurang, mohon ditambah area parkir untuk motor mahasiswa.\",\n  \"category\": \"Fasilitas\"\n}" }
      },
      "response": []
    },
    {
      "name": "List Aspirasi Saya (Mahasiswa)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations", "host": ["{{base_url}}"], "path": ["api","aspirations"] }
      },
      "response": []
    },
    {
      "name": "List Aspirasi Filter Status=dikirim",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations?status=dikirim", "host": ["{{base_url}}"], "path": ["api","aspirations"], "query": [{ "key": "status", "value": "dikirim" }] }
      },
      "response": []
    },
    {
      "name": "List SEMUA Aspirasi (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations", "host": ["{{base_url}}"], "path": ["api","aspirations"] }
      },
      "response": []
    },
    {
      "name": "Detail Aspirasi",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/{{aspiration_id}}", "host": ["{{base_url}}"], "path": ["api","aspirations","{{aspiration_id}}"] }
      },
      "response": []
    },
    {
      "name": "Edit Aspirasi (Mahasiswa)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/{{aspiration_id}}", "host": ["{{base_url}}"], "path": ["api","aspirations","{{aspiration_id}}"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"title\": \"Permohonan Parkir (Diperbarui)\",\n  \"content\": \"Mohon ditambah area parkir untuk motor dan mobil mahasiswa.\",\n  \"category\": \"Fasilitas\"\n}" }
      },
      "response": []
    },
    {
      "name": "Update Status - diproses (Admin)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/{{aspiration_id}}/status", "host": ["{{base_url}}"], "path": ["api","aspirations","{{aspiration_id}}","status"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"status\": \"diproses\",\n  \"admin_notes\": \"Aspirasi sedang dikaji oleh tim BEM.\"\n}" }
      },
      "response": []
    },
    {
      "name": "Update Status - selesai (Admin)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/{{aspiration_id}}/status", "host": ["{{base_url}}"], "path": ["api","aspirations","{{aspiration_id}}","status"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"status\": \"selesai\",\n  \"admin_notes\": \"Sudah disetujui dan akan direalisasikan.\"\n}" }
      },
      "response": []
    },
    {
      "name": "Hapus Aspirasi (Mahasiswa)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/{{aspiration_id}}", "host": ["{{base_url}}"], "path": ["api","aspirations","{{aspiration_id}}"] }
      },
      "response": []
    },
    {
      "name": "[TEST] Update Status sbg Mahasiswa - Harus 403",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_mahasiswa}}" }],
        "url": { "raw": "{{base_url}}/api/aspirations/1/status", "host": ["{{base_url}}"], "path": ["api","aspirations","1","status"] },
        "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"status\": \"selesai\"\n}" }
      },
      "response": []
    }
  ]
}